{
  // 이 꾸러미는 커누스의 SAT 프로그램을 한 줄씩 옮긴 것이고, mem 셈이 원본과
  // 똑같아야 한다. 그래서 gopls의 "현대화" 힌트를 끈다. 힌트대로 고치면
  // 원본과의 대응이 끊기거나 mem 수가 달라진다.
  //
  //   QF1003         if/else if 연쇄를 tagged switch로 (커누스의 꼴을 지킨다)
  //   minmax         if를 max/min으로 (원본에 없는 꼴이고 mem 셈이 흐려진다)
  //   slicesbackward 거꾸로 도는 반복을 slices.Backward로 (같은 까닭)
  //
  // 다른 Go 프로젝트에서는 쓸모 있는 힌트이므로 전역이 아니라 여기서만 끈다.
  "gopls": {
    "analyses": {
      "QF1003": false,
      "minmax": false,
      "slicesbackward": false
    }
  }
}
